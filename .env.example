# Environment template — copy to .env.local and fill values.
# Never commit real secrets.

# Optional: increases GitHub API rate limits for sync
GITHUB_TOKEN=

# REQUIRED in production — locks GET/POST /api/github/sync
# Generate: openssl rand -hex 32
GITHUB_SYNC_SECRET=

# Public site URL (canonical / OpenGraph) — safe to expose
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form delivery (optional — without it, contact API stores locally in cache)
CONTACT_WEBHOOK_URL=

# Comma-separated repo names to hide from the public archive
GITHUB_EXCLUDE_REPOS=theworker02,winget-pkgs
